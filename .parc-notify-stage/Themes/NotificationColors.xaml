<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="NotificationPrimaryTextColor">#10162C</Color>
    <Color x:Key="NotificationSecondaryTextColor">#465065</Color>
    <Color x:Key="NotificationMutedTextColor">#5E6675</Color>
    <SolidColorBrush x:Key="NotificationPrimaryTextBrush" Color="{StaticResource NotificationPrimaryTextColor}" />
    <SolidColorBrush x:Key="NotificationSecondaryTextBrush" Color="{StaticResource NotificationSecondaryTextColor}" />
    <SolidColorBrush x:Key="NotificationMutedTextBrush" Color="{StaticResource NotificationMutedTextColor}" />
    <SolidColorBrush x:Key="NotificationWhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NotificationCardSurfaceBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="NotificationInnerHighlightBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="NotificationDividerBrush" Color="#86FFFFFF" />
    <SolidColorBrush x:Key="NotificationCloseHoverBrush" Color="#32FFFFFF" />
    <SolidColorBrush x:Key="NotificationClosePressedBrush" Color="#50FFFFFF" />

    <Color x:Key="NotificationInfoGlowColor">#0878D1</Color>
    <SolidColorBrush x:Key="NotificationInfoAccentBrush" Color="#0878D1" />
    <SolidColorBrush x:Key="NotificationInfoAccentHoverBrush" Color="#066BBB" />
    <SolidColorBrush x:Key="NotificationInfoAccentPressedBrush" Color="#055A9E" />
    <SolidColorBrush x:Key="NotificationInfoBrightBorderBrush" Color="#69C8FF" />
    <SolidColorBrush x:Key="NotificationInfoTintBrush" Color="#5892CFFF" />
    <SolidColorBrush x:Key="NotificationInfoIconContainerBrush" Color="#4CFFFFFF" />
    <LinearGradientBrush x:Key="NotificationInfoFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1D9EDFC" Offset="0" />
        <GradientStop Color="#E9B8D9F2" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="NotificationReminderGlowColor">#D98700</Color>
    <SolidColorBrush x:Key="NotificationReminderAccentBrush" Color="#D98700" />
    <SolidColorBrush x:Key="NotificationReminderAccentHoverBrush" Color="#C17700" />
    <SolidColorBrush x:Key="NotificationReminderAccentPressedBrush" Color="#A96500" />
    <SolidColorBrush x:Key="NotificationReminderBrightBorderBrush" Color="#FFC45B" />
    <SolidColorBrush x:Key="NotificationReminderTintBrush" Color="#58F1BB69" />
    <SolidColorBrush x:Key="NotificationReminderIconContainerBrush" Color="#56FFFFFF" />
    <LinearGradientBrush x:Key="NotificationReminderFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFF0D6" Offset="0" />
        <GradientStop Color="#EAE8D1BB" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="NotificationCorrectionGlowColor">#E65A18</Color>
    <SolidColorBrush x:Key="NotificationCorrectionAccentBrush" Color="#D94A16" />
    <SolidColorBrush x:Key="NotificationCorrectionAccentHoverBrush" Color="#C53F12" />
    <SolidColorBrush x:Key="NotificationCorrectionAccentPressedBrush" Color="#A93610" />
    <SolidColorBrush x:Key="NotificationCorrectionBrightBorderBrush" Color="#FF9B58" />
    <SolidColorBrush x:Key="NotificationCorrectionTintBrush" Color="#58F4A261" />
    <SolidColorBrush x:Key="NotificationCorrectionIconContainerBrush" Color="#54FFFFFF" />
    <LinearGradientBrush x:Key="NotificationCorrectionFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFE4D2" Offset="0" />
        <GradientStop Color="#EAE6C4B5" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="NotificationUrgentGlowColor">#D92D20</Color>
    <SolidColorBrush x:Key="NotificationUrgentAccentBrush" Color="#D92D20" />
    <SolidColorBrush x:Key="NotificationUrgentAccentHoverBrush" Color="#C7281D" />
    <SolidColorBrush x:Key="NotificationUrgentAccentPressedBrush" Color="#AA2118" />
    <SolidColorBrush x:Key="NotificationUrgentBrightBorderBrush" Color="#FF8178" />
    <SolidColorBrush x:Key="NotificationUrgentTintBrush" Color="#58EF8D86" />
    <SolidColorBrush x:Key="NotificationUrgentIconContainerBrush" Color="#54FFFFFF" />
    <LinearGradientBrush x:Key="NotificationUrgentFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFDCDC" Offset="0" />
        <GradientStop Color="#EAE5C3C8" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="NotificationEscalationGlowColor">#6E3EB8</Color>
    <SolidColorBrush x:Key="NotificationEscalationAccentBrush" Color="#6E3EB8" />
    <SolidColorBrush x:Key="NotificationEscalationAccentHoverBrush" Color="#6035A2" />
    <SolidColorBrush x:Key="NotificationEscalationAccentPressedBrush" Color="#502C88" />
    <SolidColorBrush x:Key="NotificationEscalationBrightBorderBrush" Color="#BF97FF" />
    <SolidColorBrush x:Key="NotificationEscalationTintBrush" Color="#589D82D5" />
    <SolidColorBrush x:Key="NotificationEscalationIconContainerBrush" Color="#50FFFFFF" />
    <LinearGradientBrush x:Key="NotificationEscalationFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1E6DDF9" Offset="0" />
        <GradientStop Color="#E9C8C5E3" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
