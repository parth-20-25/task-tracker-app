NODE_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=DEBUG

# Required for POST /extract. Use the same value as the caller sends in x-extraction-token.
EXTRACTION_SERVICE_TOKEN=replace-with-a-secure-random-token

EXTRACTION_MAX_UPLOAD_BYTES=10485760

# Optional. Leave unset for the current local VM PostgreSQL deployment because
# the service helper forces sslmode=require when DATABASE_URL is present.
DATABASE_URL=
