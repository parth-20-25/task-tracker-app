NODE_ENV=production
PORT=5000

# Current VM production database shape. Keep the real password only in .env.production.
DATABASE_URL=postgresql://parc_user:<password>@localhost:5432/parc_task_tracker
DATABASE_SSL=false

JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://192.168.1.227:4173

UPLOADS_DIR=uploads
REPORT_TEMP_DIR=
ENABLE_TASK_SEED=false
RBAC_AUTO_CREATE_PERMISSIONS=false

# Optional storage integration for native ingestion uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TaskControl <no-reply@taskcontrol.local>

# Optional report formatter overrides.
REPORT_FORMATTER_SCRIPT=
REPORT_FORMATTER_PYTHON=

# Optional analytics tuning.
PERFORMANCE_MIN_APPROVED_TASKS=5
DEPARTMENT_OVERDUE_PENALTY_FACTOR=1
PERFORMANCE_ANALYTICS_REFRESH_MS=900000

# Debug-only flag. Keep false in production.
PROJECT_VISIBILITY_DEBUG=false
