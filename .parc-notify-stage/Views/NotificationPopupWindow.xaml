<Window x:Class="ParcNotify.Agent.Views.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ParcNotify.Agent.Models"
        Title="PARC Task Tracker notification"
        Width="365"
        Height="172"
        MinWidth="365"
        MaxWidth="365"
        MinHeight="172"
        MaxHeight="172"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Background="{Binding FallbackBrush}"
        Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ParcNotify.Agent;component/Themes/NotificationColors.xaml" />
                <ResourceDictionary Source="/ParcNotify.Agent;component/Themes/NotificationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Grid.RenderTransform>

        <Border x:Name="AcrylicBackdropLayer"
                Margin="4"
                Background="{DynamicResource NotificationCardSurfaceBrush}"
                CornerRadius="12"
                IsHitTestVisible="False" />

        <Border x:Name="SeverityTintBorder"
                Margin="4"
                Background="{Binding TintBrush}"
                CornerRadius="12"
                IsHitTestVisible="False" />

        <Border x:Name="InnerHighlightBorder"
                Margin="5"
                BorderBrush="{DynamicResource NotificationInnerHighlightBrush}"
                BorderThickness="1"
                CornerRadius="11"
                IsHitTestVisible="False" />

        <Border x:Name="ContentCard" Margin="4" CornerRadius="12" Background="Transparent" ClipToBounds="True">
            <Grid x:Name="SharpContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="31" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="90" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="41" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="11,2,7,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="27" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="LogoImage"
                           Width="86"
                           Height="25"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Source="pack://application:,,,/ParcNotify.Agent;component/Assets/PARCLogo-Notification.png"
                           AutomationProperties.Name="PARC logo" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding EventTitle}"
                               Margin="5,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Style="{StaticResource NotificationIconButtonStyle}"
                            Tag="Close"
                            ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss notification"
                            Click="CloseButton_Click">
                        <Path Width="12"
                              Height="12"
                              Stroke="{DynamicResource NotificationPrimaryTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M3,3 L17,17 M17,3 L3,17"
                              Stretch="Uniform" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Margin="11,0" Background="{DynamicResource NotificationDividerBrush}" />

                <Grid Grid.Row="2" Margin="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="{Binding IconContainerBrush}"
                            BorderBrush="{Binding BrightBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                        <Path Width="18"
                              Height="18"
                              Data="{Binding IconGlyph}"
                              Stroke="{Binding IconBrush}"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding TaskSummary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource NotificationPrimaryTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasTaskSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Metadata}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource NotificationSecondaryTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="2" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       Foreground="{Binding StatusBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource NotificationSecondaryTextBrush}"
                                       TextWrapping="NoWrap">
                                <Run Text="Priority: " />
                                <Run Text="{Binding Priority}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Row="3"
                                   Text="{Binding ActionError}"
                                   Margin="0,3,0,0"
                                   MaxHeight="14"
                                   FontSize="10"
                                   Foreground="{Binding AccentBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasActionError, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Margin="11,0" Background="{DynamicResource NotificationDividerBrush}" />

                <ItemsControl Grid.Row="4"
                              Margin="8,5"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding Actions}"
                              Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NotificationActionViewModel}">
                            <Button Style="{StaticResource NotificationActionButtonStyle}"
                                    Command="{Binding Command}"
                                    AutomationProperties.Name="{Binding Label}">
                                <TextBlock Text="{Binding DisplayLabel}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border x:Name="OuterGlowLayer"
                Margin="4"
                BorderBrush="{Binding BrightBorderBrush}"
                BorderThickness="1.5"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.55"
                                  Color="{Binding GlowColor}" />
            </Border.Effect>
        </Border>
    </Grid>
</Window>
